{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NAAb",
  "scopeName": "source.naab",
  "fileTypes": ["naab"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#polyglot-block" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#block-id" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#function-call" },
    { "include": "#stdlib-module" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.naab",
          "match": "//.*$"
        },
        {
          "name": "comment.line.hash.naab",
          "match": "#.*$"
        },
        {
          "name": "comment.block.naab",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.naab" }
          }
        }
      ]
    },

    "polyglot-block": {
      "patterns": [
        {
          "name": "meta.embedded.block.naab",
          "begin": "(<<)(python|javascript|rust|cpp|go|csharp|ruby|php|shell|bash|nim|zig|julia)(\\[[^\\]]*\\])?(\\s*->\\s*\\w+)?",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.polyglot.begin.naab" },
            "2": { "name": "entity.name.tag.language.naab" },
            "3": { "name": "variable.parameter.binding.naab" },
            "4": { "name": "storage.type.return.naab" }
          },
          "end": "^\\s*>>",
          "endCaptures": {
            "0": { "name": "punctuation.definition.polyglot.end.naab" }
          },
          "contentName": "string.unquoted.polyglot.naab"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.naab",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.naab",
              "match": "\\\\[ntr\\\\\"'0]"
            },
            {
              "name": "meta.interpolation.naab",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.interpolation.begin.naab" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.definition.interpolation.end.naab" }
              },
              "patterns": [
                { "include": "source.naab" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.naab",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.naab",
              "match": "\\\\[ntr\\\\\"'0]"
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.naab",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.float.naab",
          "match": "\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.naab",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "block-id": {
      "patterns": [
        {
          "name": "entity.name.label.block-id.naab",
          "match": "\\bBLOCK-[A-Z+\\-]+-\\d+\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.naab",
          "match": "\\b(if|else|for|in|while|break|continue|match|return|try|catch|throw|finally)\\b"
        },
        {
          "name": "keyword.declaration.naab",
          "match": "\\b(let|const)\\b"
        },
        {
          "name": "keyword.function.naab",
          "match": "\\b(fn|function|func|def|async|await|method)\\b"
        },
        {
          "name": "keyword.structure.naab",
          "match": "\\b(main|struct|class|enum|module|init|new|config|default|ref|runtime)\\b"
        },
        {
          "name": "keyword.import.naab",
          "match": "\\b(use|import|export|from|as)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.naab",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.naab",
          "match": "\\bnull\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.naab",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.fat-arrow.naab",
          "match": "=>"
        },
        {
          "name": "keyword.operator.arrow.naab",
          "match": "->"
        },
        {
          "name": "keyword.operator.namespace.naab",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.naab",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.comparison.naab",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.naab",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.naab",
          "match": "\\+=|-=|\\*=|/=|%=|="
        },
        {
          "name": "keyword.operator.arithmetic.naab",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.naab",
          "match": "\\||&"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.colon.naab",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.question.naab",
          "match": "\\?"
        },
        {
          "name": "punctuation.separator.semicolon.naab",
          "match": ";"
        }
      ]
    },

    "stdlib-module": {
      "patterns": [
        {
          "name": "support.class.stdlib.naab",
          "match": "\\b(array|string|math|json|http|file|time|debug|env|csv|regex|crypto|bolo|io)\\b(?=\\.)"
        }
      ]
    },

    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.naab" }
          }
        }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.naab",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
